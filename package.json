{
  "name": "oatutor-content",
  "version": "0.1.0",
  "private": true,
  "description": "Commercially verified subset of CAHLR/OATutor-Content for Epiphanie",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "tsx scripts/audit.ts",
    "report": "tsx scripts/report.ts",
    "build:content": "tsx scripts/build.ts",
    "verify": "tsx scripts/verify.ts",
    "pin": "tsx scripts/pin.ts",
    "update": "tsx scripts/update-upstream.ts"
  },
  "dependencies": {
    "spdx-correct": "^3.2.0",
    "spdx-expression-parse": "^4.0.0",
    "spdx-license-ids": "^3.0.20",
    "spdx-satisfies": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/spdx-correct": "^3.1.3",
    "@types/spdx-expression-parse": "^3.0.5",
    "@types/spdx-satisfies": "^0.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
